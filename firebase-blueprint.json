{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user was created"
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether notifications are enabled"
        },
        "darkMode": {
          "type": "boolean",
          "description": "Whether dark mode is enabled"
        },
        "theme": {
          "type": "string",
          "enum": ["default", "cyberpunk", "tropical", "rose"],
          "description": "Selected UI theme"
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"],
          "description": "User access role"
        }
      },
      "required": ["name", "email", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A study note uploaded by a user",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "author": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "views": { "type": "string" },
        "fileData": { "type": "string" },
        "mimeType": { "type": "string" }
      },
      "required": ["title", "subject", "content", "author", "userId", "date", "isPublic"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Study notes"
    }
  }
}
